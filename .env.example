# Copy to `.env` and fill in a key. `.env` is gitignored — never commit it.
#
# The tool works with any OpenAI-compatible provider. Pick one:
#
# 1) OpenAI (paid, ~$0.005–0.02/run on gpt-4o-mini):
#      OPENAI_API_KEY=sk-...
#
# 2) FREE — Groq free tier (fast):
#      LLM_API_KEY=gsk_...
#      LLM_BASE_URL=https://api.groq.com/openai/v1
#      LLM_MODEL=llama-3.3-70b-versatile
#
# 3) FREE — Gemini free tier (OpenAI-compatible endpoint):
#      LLM_API_KEY=AIza...
#      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#      LLM_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
